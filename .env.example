# Copy to .env and fill in. Never commit the real .env.
POSTGRES_USER=relevance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=image_relevance
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the Gemini model used for vision and article analysis
# VISION_MODEL=gemini-3.5-flash

# Key required in the X-API-Key header for write endpoints (generate a long random string)
REVIEW_API_KEY=change-me-long-random-string
